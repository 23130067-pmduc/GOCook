# Copy this file to .env for local development.
# .env is ignored by Git.

# PostgreSQL (matches compose.yaml defaults)
URL_DB=jdbc:postgresql://localhost:5432/app_db
USER_NAME_DB=app_user
PASSWORD_DB=app_password

# Redis
REDIS_HOST_DEV=localhost
REDIS_PORT_DEV=6379

# RabbitMQ
RABBIT_MQ_DEV=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT - replace with your own long random value
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-64-characters

# Local HTTP cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# SMTP (optional until you test mail)
# For Gmail, use an App Password, not your normal account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudinary (optional; only needed for avatar upload)
USER_SERVICE_CLOUDINARY_NAME=
USER_SERVICE_CLOUDINARY_API_KEY=
USER_SERVICE_CLOUDINARY_API_SECRET=
