# PostgreSQL (khớp compose.yaml)
URL_DB=jdbc:postgresql://localhost:5432/app_db
USER_NAME_DB=app_user
PASSWORD_DB=app_password

# Redis
REDIS_HOST_DEV=localhost
REDIS_PORT_DEV=6379

# RabbitMQ
RABBIT_MQ_DEV=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT - thay bằng chuỗi bí mật đủ dài của riêng bạn
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
JWT_ACCESS_TOKEN_EXPIRATION=259200000
JWT_REFRESH_TOKEN_EXPIRATION=2419200000
JWT_RESET_PASSWORD_TOKEN_EXPIRATION=900000

# Gmail SMTP - MAIL_PASSWORD là Google App Password, không phải mật khẩu Gmail thường
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=YOUR_16_CHARACTER_APP_PASSWORD

# Cloudinary (chỉ cần nếu dùng upload ảnh)
USER_SERVICE_CLOUDINARY_NAME=
USER_SERVICE_CLOUDINARY_API_KEY=
USER_SERVICE_CLOUDINARY_API_SECRET=
